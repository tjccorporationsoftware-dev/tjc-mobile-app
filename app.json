{
  "expo": {
    "name": "tjc-mobile-app",
    "slug": "tjc-mobile-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/LogoTJC.png",
    "scheme": "tjcmobileapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/LogoTJC.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.davit097.tjcmobileapp",
      "infoPlist": {
        "NSCameraUsageDescription": "แอปต้องการเข้าถึงกล้องเพื่อถ่ายรูปใบเสร็จและหน้างาน",
        "NSPhotoLibraryUsageDescription": "แอปต้องการเข้าถึงคลังภาพเพื่ออัปโหลดรูปภาพ",
        "NSLocationWhenInUseUsageDescription": "แอปต้องการเข้าถึงตำแหน่งของคุณเพื่อระบุจุดปฏิบัติงาน"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/LogoTJC.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.davit097.tjcmobileapp",
      
      "usesCleartextTraffic": true,
      
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.INTERNET"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/LogoTJC.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "แอปต้องการเข้าถึงรูปภาพเพื่ออัปโหลดรายงาน",
          "cameraPermission": "แอปต้องการเข้าถึงกล้องเพื่อถ่ายรูปใบเสร็จ"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "แอปต้องการตำแหน่งเพื่อบันทึกพิกัดการทำงาน"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0f16257d-1706-4520-9bc3-4073a27cfcc5"
      }
    }
  }
}