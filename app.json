{
  "expo": {
    "name": "TJC GROUP",
    "slug": "TJC-ROUP",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/LOGO TJCV.002.png",
    "scheme": "tjcmobileapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tjcgroup.tjcmobileapp",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/LOGO TJCV.002.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.tjcgroup.tjcmobileapp"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/LOGO TJCV.002.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/LOGO TJCV.002.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4800aa9b-fb62-45e2-b30d-12b1359d292b"
      }
    }
  }
}